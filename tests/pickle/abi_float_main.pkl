module abi_float_main

import { abiStrFromF64 } from runtime.abi_float
import { emitCstr } from runtime.abi_console

fn show(tag: string, v: float) {
    print(tag)
    print(" ")
    print(v)
    print(" ")
    print("{v}")
    print("\n")
}

fn main() {
    show("zero", 0.0)
    show("negzero", -0.0)
    show("one", 1.0)
    show("negone", -1.0)
    show("tenth", 0.1)
    show("twotenth", 0.2)
    show("threetenth", 0.3)
    show("onethird", 1.0 / 3.0)
    show("half", 0.5)
    show("two", 2.0)
    show("ten", 10.0)
    show("hundred", 100.0)
    show("pi", 3.141592653589793)
    show("e", 2.718281828459045)
    show("1e15", 1e15)
    show("1e16", 1e16)
    show("1e17", 1e17)
    show("1e20", 1e20)
    show("1e100", 1e100)
    show("1e300", 1e300)
    show("1em1", 1e-1)
    show("1em4", 1e-4)
    show("1em5", 1e-5)
    show("1em10", 1e-10)
    show("1em15", 1e-15)
    show("1em300", 1e-300)
    show("big123", 123456789012345678.0)
    show("pow253", 9007199254740993.0)
    show("oddsum", 0.1 + 0.2)
    show("inf", f64FromBits(0x7FF0000000000000))
    show("neginf", -f64FromBits(0x7FF0000000000000))
    show("nan", f64FromBits(0x7FF8000000000000))
    show("minsub", f64FromBits(0x0000000000000001))
    show("max", f64FromBits(0x7FEFFFFFFFFFFFFF))
    show("minnorm", f64FromBits(0x0010000000000000))
    show("1e6", 1e6)
    show("digits9", 123456789.0)
    show("longfrac", 1234567.891)
    show("thousandth", 0.007)
    show("neg", -1.5)
    show("negtenth", -0.1)
    show("1e18", 1e18)
    show("1e19", 1e19)
    show("2p5", 2.5)
    show("tiny1e32", 1e-32)
}

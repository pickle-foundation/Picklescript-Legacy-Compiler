module std.process

import { sliceRange } from std.text.format
import { decodeCp, cpLen, encodeCpStr } from std.text.utf8

/// Captured subprocess seeds (`std.process`). `Result` snapshots
/// code/stdout/stderr/timed-out from `run_cmd`-style captures; `Proc` is a
/// builder over the same capture (`run()`), plus an async `Stream` handle via
/// `run_spawn`/`proc_*` when needed. Errors are values: a spawn failure
/// surfaces as a `Result` with no exit code (`ok()` is then `false`), and
/// `run_spawn` returns `none` for a program that cannot start.

/// Split `s` into lines on `\n`, stripping one trailing `\r` per line. Slices
/// at newline boundaries, which are ASCII bytes, so UTF-8 content survives.
fn splitLines(s: string) -> List<string> {
    let b = bytes(s)
    let n = len(b)
    if (n == 0) {
        var empty = [""]
        empty.pop()
        return empty
    }
    var out = [""]
    out.pop()
    var start = 0
    var i = 0
    while (i < n) {
        if ((b[i] as int) == 10) {
            var end = i
            if (end > start && (b[end - 1] as int) == 13) {
                end = end - 1
            }
            out.push(sliceRange(s, start, end))
            start = i + 1
        }
        i += 1
    }
    var end = n
    if (end > start && (b[end - 1] as int) == 13) {
        end = end - 1
    }
    if (end > start) {
        out.push(sliceRange(s, start, end))
    }
    out
}

/// Copy the scalar starting at byte offset `i` of `b` onto `tok`, returning
/// the new token and the next offset. Malformed sequences become U+FFFD.
fn appendScalar(tok: string, b: List<byte>, i: int) -> (string, int) {
    if (let some(cp) = decodeCp(b, i)) {
        return (tok + u8str(cp), i + cpLen(b[i] as int))
    }
    (tok + "\u{FFFD}", i + 1)
}

/// The UTF-8 string for a scalar code point (via the shared writer).
fn u8str(cp: int) -> string {
    encodeCpStr(cp)
}

/// The outcome of a captured command: exit code (`none` for a signal death or
/// spawn failure), stdout, stderr, and whether a timeout fired.
class Result {
    var code: int?
    var out: string
    var err: string
    var timed_out: bool

    constructor(c: int?, o: string, e: string, t: bool) {
        this.code = c
        this.out = o
        this.err = e
        this.timed_out = t
    }

    /// Whether the program exited successfully (`code == 0`).
    fn ok() -> bool {
        if (let some(c) = this.code) {
            return c == 0
        }
        false
    }

    /// The exit code as `int?`; `none` when it was not captured.
    fn exitCode() -> int? {
        this.code
    }

    /// Captured stdout.
    fn stdout() -> string {
        this.out
    }

    /// Captured stderr.
    fn stderr() -> string {
        this.err
    }

    /// Whether the run hit its timeout (child was killed).
    fn timedOut() -> bool {
        this.timed_out
    }

    /// The first line of stdout, or `""` when there is none.
    fn firstLine() -> string {
        let ls = this.lines()
        if (len(ls) > 0) {
            return ls[0]
        }
        ""
    }

    /// stdout split into lines (trailing `\r` stripped, no trailing blank).
    fn lines() -> List<string> {
        splitLines(this.out)
    }
}

/// A subprocess builder: capture by default (`run`/`runOk`/`output`),
/// configurable working dir, environment, stdin bytes, and timeout.
class Proc {
    var argv: List<string>
    var cwd: string?
    var envs: Map<string, string>?
    var env_removes: List<string>?
    var stdin_bytes: List<byte>?
    var timeout_ms: int?

    constructor(argv: List<string>) {
        this.argv = argv
        this.cwd = none
        // A concrete map so `withEnv` can always mutate in place; the dummy
        // `""` key is dropped on first use.
        this.envs = {"": ""}
        this.env_removes = none
        this.stdin_bytes = none
        this.timeout_ms = none
    }

    /// Run in `dir` instead of the current directory.
    fn setCwd(dir: string) -> Proc {
        this.cwd = dir
        this
    }

    /// Set an environment variable for the child (applied after removals).
    fn withEnv(k: string, v: string) -> Proc {
        if (let some(ems) = this.envs) {
            if (ems.has("")) {
                ems.remove("")
            }
            ems[k] = v
        }
        this
    }

    /// Remove an environment variable inherited by the child.
    fn withoutEnv(k: string) -> Proc {
        if (let some(ls) = this.env_removes) {
            ls.push(k)
        } else {
            let fresh = [k] as List<string>
            this.env_removes = fresh
        }
        this
    }

    /// Feed `b` to the child's stdin; `none` keeps standard input null.
    fn withStdin(b: List<byte>?) -> Proc {
        this.stdin_bytes = b
        this
    }

    /// Kill the child after `ms` milliseconds (unit test / watchdog use).
    fn withTimeout(ms: int) -> Proc {
        this.timeout_ms = ms
        this
    }

    /// Run to completion and capture the outcome (`Result` always).
    fn run() -> Result {
        if (let some(ems) = this.envs) {
            if (ems.has("")) {
                ems.remove("")
            }
        }
        let r = run_cmd(this.argv, this.cwd, this.envs, this.env_removes, this.stdin_bytes, none, this.timeout_ms, false)
        if (let some(t) = r) {
            match (t) {
                case (code, out, err, timed) -> { return Result(code, out, err, timed) }
                case _ -> { return Result(none, "", "", false) }
            }
        }
        Result(none, "", "", false)
    }

    /// Whether a capture run exited successfully.
    fn runOk() -> bool {
        this.run().ok()
    }

    /// Capture run (alias kept for reads like `process.exitCode`).
    fn output() -> Result {
        this.run()
    }
}

/// Capture `argv` (current directory, null stdin, no timeout).
fn proc(argv: List<string>) -> Result {
    Proc(argv).run()
}

/// `git` in `root`: `git(root, ["log", "--name-only", ...])`.
fn git(root: string, args: List<string>) -> Result {
    let full = ["git"] as List<string>
    for (a in args) {
        full.push(a)
    }
    Proc(full).setCwd(root).run()
}

/// The current working directory, or `none`.
fn currentDir() -> string? {
    current_dir()
}

/// Split a command line into argv honoring single/double quotes (shell-like,
/// no escapes). Malformed UTF-8 bytes decode as U+FFFD.
fn shSplit(line: string) -> List<string> {
    let b = bytes(line)
    let n = len(b)
    var out = [""]
    out.pop()
    var i = 0
    while (i < n) {
        while (i < n && ((b[i] as int) == 32 || (b[i] as int) == 9)) {
            i += 1
        }
        if (i >= n) {
            break
        }
        var tok = ""
        var inS = false
        var inD = false
        while (i < n) {
            let c = b[i] as int
            let atSpace = (c == 32 || c == 9) && !inS && !inD
            if (atSpace) {
                break
            }
            if (!inS && !inD && c == 39) {
                inS = true
                i += 1
            } else if (!inS && !inD && c == 34) {
                inD = true
                i += 1
            } else if (inS && c == 39) {
                inS = false
                i += 1
            } else if (inD && c == 34) {
                inD = false
                i += 1
            } else {
                let rr = appendScalar(tok, b, i)
                match (rr) {
                    case (nt, ni) -> {
                        tok = nt
                        i = ni
                    }
                }
                i = i
            }
        }
        out.push(tok)
    }
    out
}

/// Run `commands` left to right, feeding each stage's stdout to the next
/// stage's stdin (buffered via captures). Returns the last stage's result, or
/// the first failure as soon as it happens.
fn pipe(commands: List<List<string>>) -> Result {
    var input: List<byte>? = none
    var last = Result(none, "", "", false)
    for (c in commands) {
        last = Proc(c).withStdin(input).run()
        if (last.ok()) {
            input = bytes(last.stdout())
        } else {
            return last
        }
    }
    last
}
module main

// Top-level `var` is a real data slot that outlives `main` and keeps its value
// between calls, unlike a top-level `const` (which is inlined at every use).
var counter: int = 7
var zero: int = 0
var negative: int = -5
var inferred = 42
var MAX: int = 100

fn bump(): int {
    counter = counter + 1
    return counter
}

fn reset(): int {
    counter = 7
    return counter
}

fn main() {
    println("counter starts at:", counter)
    println("zero:", zero)
    println("negative:", negative)
    println("inferred:", inferred)

    // Reads are plain loads; the value persists across calls.
    println("bump 1:", bump())
    println("bump 2:", bump())
    println("bump 3:", bump())
    assert(counter == 10, "compound-style increment lost its value")

    // Direct write.
    counter = 7
    println("after reset:", counter)
    assert(counter == 7, "direct assignment did not reach the global")

    // Compound assignment is read-modify-write, never a blind store of the
    // right-hand side: `zero` must still contribute its own value.
    counter += 3
    println("counter += 3:", counter)
    counter -= 1
    println("counter -= 1:", counter)
    counter *= 2
    println("counter *= 2:", counter)
    counter /= 3
    println("counter /= 3:", counter)

    // Two globals combined, proving reads are independent loads.
    println("counter + zero:", counter + zero)
    println("counter + MAX:", counter + MAX)
    println("counter + inferred:", counter + inferred)

    // Globals and locals share one namespace at runtime without aliasing.
    var localShadow = 1
    localShadow = localShadow + 100
    println("local:", localShadow)
    println("global unchanged:", counter)

    // Expressions may read a global on both sides of a comparison.
    assert(counter < MAX, "counter should still be below MAX")
    assert(counter > zero, "counter should stay above zero")

    reset()
    println("reset again:", counter)
}